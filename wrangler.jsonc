{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qr-link-api",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://sofwankaji.github.io" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qr-link-db",
      "database_id": "267afa1c-25b1-44b5-bcc4-8e66d9607d08"
    }
  ]
}
