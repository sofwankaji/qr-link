# Public origin used in short links. Use your real deployed HTTPS URL.
# PUBLIC_BASE_URL=https://qr-link.example.com
# Render automatically supplies RENDER_EXTERNAL_URL if PUBLIC_BASE_URL is unset.

# Production listens on all interfaces. Override HOST for a local-only server.
# HOST=127.0.0.1
PORT=3000
# Store SQLite on your hosting provider's persistent disk.
# DB_PATH=/var/data/links.sqlite
